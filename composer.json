{
  "name": "smartresponsor/currencing",
  "description": "Smart Responsor Currencing component for ISO currency metadata, minor units, money normalization, formatting, and conversion-boundary validation.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "php": "^8.4",
    "symfony/asset": "^7.3 || ^8.0",
    "symfony/console": "^7.3 || ^8.0",
    "symfony/dotenv": "^7.3 || ^8.0",
    "symfony/flex": "^2.4",
    "symfony/form": "^7.3 || ^8.0",
    "symfony/framework-bundle": "^7.3 || ^8.0",
    "symfony/runtime": "^7.3 || ^8.0",
    "symfony/twig-bundle": "^7.3 || ^8.0",
    "symfony/validator": "^7.3 || ^8.0",
    "symfony/var-exporter": "^7.3",
    "symfony/yaml": "^7.3 || ^8.0",
    "twig/extra-bundle": "^3.21",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.0",
    "symfony/maker-bundle": "^1.64"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^7.3 || ^8.0"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "currencing:gates": [
      "php tools/currencing-structure-check.php",
      "php tools/currencing-runtime-smoke-check.php",
      "php tools/currencing-autoload-smoke-check.php",
      "php tools/currencing-service-alias-closure-check.php",
      "php tools/currencing-console-runtime-proof-check.php",
      "php tools/currencing-database-runtime-proof-check.php",
      "php tools/currencing-api-contract-check.php",
      "php tools/currencing-release-candidate-check.php",
      "php tools/currencing-standalone-runtime-foundation-check.php"
    ]
  }
}
