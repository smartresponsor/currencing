# Currencing local PostgreSQL runtime proof override.
# Copy this file to .env.local and adjust credentials to your local PostgreSQL role.
# Do not commit .env.local.

# Option A: dedicated local role/database.
DATABASE_URL="postgresql://currencing:currencing@127.0.0.1:5432/currencing?serverVersion=16&charset=utf8"

# Option B: use an existing local superuser role only for local proof.
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/currencing?serverVersion=16&charset=utf8"
